# Dockplane agent settings.
#
# Read by the systemd unit. Everything here is optional; the agent runs with
# none of it set. No secret belongs in this file: the enrollment token is
# handed to `dockplane-agent enroll` once and never stored, and the agent's
# private key never leaves its state directory.

# Where the agent keeps its identity. The unit creates and owns this path.
#DOCKPLANE_AGENT_STATE_DIR=/var/lib/dockplane-agent

# An additional certificate authority to trust for the control server's own
# certificate, for deployments behind a private web PKI. The authority that
# issued the agent's certificate is trusted already.
#DOCKPLANE_AGENT_TRUST_BUNDLE=/etc/dockplane-agent/trust-bundle.pem

# debug, info, warn or error.
#DOCKPLANE_AGENT_LOG_LEVEL=info
