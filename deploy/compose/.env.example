# Dockplane control plane.
#
# Copy to .env beside compose.yaml and fill in. Keep it readable only by the
# account that runs the stack:
#
#   chmod 0600 .env
#
# No secret belongs in this file. Passwords and keys are files under secrets/,
# mounted into the containers rather than placed in their environment, so they
# do not appear in `docker inspect` or in the environment of child processes.

# The hostname browsers use. Its A/AAAA record must point at this machine
# before the first start, because Caddy asks Let's Encrypt for a certificate
# for it. Not a marketing domain; this is the authenticated control plane.
DOCKPLANE_DOMAIN=dockplane.example.com

# The release to run. Both images carry this tag; a stack is one version of
# Dockplane, and pinning it is what makes a deployment reproducible.
#
# In a release bundle this names that release. The installer owns the value in
# a real deployment's .env and rewrites it on every upgrade.
DOCKPLANE_VERSION=0.1.0

# Where the images come from. Override to run images you built yourself.
DOCKPLANE_API_IMAGE=ghcr.io/dockplanee/dockplane-control-server
DOCKPLANE_WEB_IMAGE=ghcr.io/dockplanee/dockplane-web

# Database. The password itself lives in secrets/postgres-password, and the
# connection string the server uses lives in secrets/database-url.
POSTGRES_DB=dockplane
POSTGRES_USER=dockplane

# The agent certificate authority and the gateway key pair, created once with
# `setup:agent-ca` and mounted read-only. Losing this directory means every
# host has to be enrolled again.
DOCKPLANE_PKI_DIR=./pki

# Where the secret files are read from.
DOCKPLANE_SECRETS_DIR=./secrets

# The port agents connect to. Must be reachable from every managed host.
AGENT_GATEWAY_PORT=9443

# Proxies in front of the API. One, because Caddy is in front of it. A value
# that is too high lets a client spoof its source address and defeat the
# per-address abuse controls.
TRUSTED_PROXY_HOPS=1

# silent, fatal, error, warn, info, debug or trace.
LOG_LEVEL=info

# The uid and gid the control server runs as, in the container and on the host.
# The secrets and the certificate authority are owned by it. Deliberately not
# 1000, which on most distributions is the first human login account.
DOCKPLANE_UID=10001
DOCKPLANE_GID=10001

# Where "Add host" downloads the agent package from. Unset, it is the project's
# own releases. Set it to serve the packages from somewhere else — a mirror, or
# a release being rehearsed before it is published.
#AGENT_RELEASE_BASE_URL=https://github.com/Dockplanee/dockplane/releases/download

# Which agent version "Add host" installs.
#
# Leave this alone. Unset, a new host is given the agent matching this control
# plane, which is the only pairing this project builds and tests together — and
# it follows the control plane across every upgrade on its own.
#
# Setting it pins the agent to one version and keeps it there. That is an
# override, not a default: it stays put when the control plane is upgraded, so
# new hosts go on receiving the version named here. The installer says so on
# every upgrade, and `dockplane-control doctor` reports it. Nothing removes it
# but you.
#AGENT_RELEASE_VERSION=

# Whether Dockplane checks the project's public release listing for a newer
# version.
#
# Off. A self-hosted control plane does not reach out because somebody opened a
# page, so this stays off on a new installation and across every upgrade until
# it is set here.
#
# Turned on, the control server reads the public release listing at most a few
# times a day and shows what it says. The request carries nothing about this
# installation: no identifier, no domain, no hostnames, no counts, no versions.
# Nothing is downloaded, installed or changed by it — upgrading remains the
# documented manual process.
#UPDATE_CHECK_ENABLED=true
