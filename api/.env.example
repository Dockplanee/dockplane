# Dockplane control server configuration.
# Copy to .env and fill in. Never commit a filled-in file.

NODE_ENV=development
PORT=3000

# Address the API binds. Set this to 127.0.0.1 when a reverse proxy on the same
# machine is the only thing that should reach it.
HOST=0.0.0.0

# PostgreSQL connection for durable control-plane state.
DATABASE_URL=postgres://dockplane:dockplane@localhost:5433/dockplane

# Origin the browser application is served from. Used for session cookies and
# the origin check that protects state-changing requests.
PUBLIC_APP_URL=http://localhost:4200

SESSION_COOKIE_NAME=dockplane_session
SESSION_TTL=12h
SESSION_IDLE_TIMEOUT=2h

# 32 bytes, base64 encoded. Protects MFA secrets at rest and is deliberately
# separate from the database so a database copy alone cannot decrypt them.
# Generate with: openssl rand -base64 32
APPLICATION_ENCRYPTION_KEY=

# Number of reverse proxies allowed to set X-Forwarded-For. Leave at 0 unless a
# proxy is actually in front of the API; a wrong value lets clients spoof their
# source address and defeat per-IP abuse controls.
TRUSTED_PROXY_HOPS=0

# Agent gateway. Separate listener from browser traffic; mTLS is required and
# must remain end-to-end. See docs/getting-started/control-server.md.
AGENT_GATEWAY_HOST=0.0.0.0
AGENT_GATEWAY_PORT=9443
AGENT_GATEWAY_ADVERTISED_URL=https://localhost:9443

# Created by: npm run setup:agent-ca -- ./pki <hostnames>
AGENT_GATEWAY_TLS_CERT_PATH=./pki/gateway.crt
AGENT_GATEWAY_TLS_KEY_PATH=./pki/gateway.key
AGENT_CLIENT_CA_CERT_PATH=./pki/agent-ca.crt
AGENT_CA_CERT_PATH=./pki/agent-ca.crt
AGENT_CA_KEY_PATH=./pki/agent-ca.key
# Optional passphrase for an encrypted CA key.
AGENT_CA_KEY_PASSPHRASE=

AGENT_CERT_TTL=30d
AGENT_CERT_RENEW_BEFORE=7d
AGENT_ENROLLMENT_TTL=10m
AGENT_MAX_MESSAGE_BYTES=1048576

LOG_LEVEL=info

# Development only. Allows session cookies without the Secure attribute so the
# interface works over plain HTTP locally. Startup fails if this is true while
# NODE_ENV=production.
DEV_ALLOW_INSECURE_COOKIES=false
